# Copy this file to e2e/.env.test and fill in a disposable administrator account.
BASE_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
TEST_IDENTIFIER=
TEST_PASSWORD=

# Dedicated disposable institution reused by all employee, payroll, reports,
# and employee-setup tests. The institution must already exist in the target
# database; its child data is reset around every test.
E2E_INSTITUTION_ID=
E2E_INSTITUTION_USERNAME=
E2E_INSTITUTION_PASSWORD=

# Optional aliases for the administrator credentials.
# ADMIN_IDENTIFIER=
# ADMIN_PASSWORD=
